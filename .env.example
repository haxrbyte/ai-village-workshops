# ---------------------------------------------------------------------------
# Copy to .env and edit, or just run ./setup.sh which writes it for you.
# There is no secret in this file.
# ---------------------------------------------------------------------------

# The port the lab listens on. 8080 rather than 80 so it does not collide with
# a local webserver and works under rootless Docker.
LAB_PORT=8080

# Where the published images live, and which tag to pull. Pin LAB_VERSION to a
# release tag (e.g. v1.0.0) for reproducibility; `edge` tracks main.
IMAGE_PREFIX=ghcr.io/OWNER/REPO
LAB_VERSION=edge

# What attack payloads embed. This is resolved by the nginx NETWORK ALIAS
# inside Docker, not by your machine's DNS — you do not need it in /etc/hosts
# and it does not need to resolve on your LAN. Do not change it: the exercises'
# measured payloads contain this string literally.
LAB_URL=http://northwind.local
TZ=UTC

# Workshop 1's model.
#   macOS  -> host Ollama at host.docker.internal (Docker cannot reach Metal)
#   Linux  -> set COMPOSE_PROFILES=ollama and use http://ollama:11434
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
COMPOSE_PROFILES=

# 'live' = real model. 'canned' = scripted replies, no model needed; all seven
# exercises still score, but only for the intended payloads.
MAILMATE_BACKEND=live

# How many model calls run at once, and how long a request waits for a slot
# before falling back to a scripted reply. The 4/8 defaults were a ROOM policy
# for 18 people -- shed rather than make everyone wait. Running alone you want
# to wait, not to be silently handed a canned answer.
OLLAMA_CONCURRENCY=2
OLLAMA_WAIT_SECONDS=20
